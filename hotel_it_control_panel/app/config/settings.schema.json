{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "default_ip_range": {"type": "string"},
    "recent_ips": {"type": "array", "items": {"type": "string"}},
    "server_list": {"type": "array", "items": {"type": "string"}},
    "tools": {
      "type": "object",
      "properties": {
        "anydesk_path": {"type": "string"},
        "rustdesk_path": {"type": "string"},
        "teamviewer_path": {"type": "string"}
      }
    },
    "messaging": {
      "type": "object",
      "properties": {
        "server_url": {"type": "string"},
        "token": {"type": "string"}
      }
    },
    "theme": {"type": "string"},
    "role": {"type": "string"},
    "log_retention_days": {"type": "integer"},
    "central_policy_path": {"type": "string"}
  },
  "required": ["default_ip_range", "tools", "messaging", "theme", "role"]
}
